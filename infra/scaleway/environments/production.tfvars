# Provider
project_name = "eigin-production"
scw_region   = "fr-par"

# Relay: General config
max_scale = 3

# Relay: Search config
monthly_pool_size = 5000

# Relay: IAP config
apple_environment  = "Production"
apple_bundle_id    = "com.42futures.carrel"
apple_app_apple_id = ""

# Relay: Inference config
upstream_api_url                = "https://api.berget.ai/v1"
admit_floor_credits             = 50
token_rate_limit_requests       = 20
token_rate_limit_window_seconds = 60

# Relay: Grants config
grant_issuer = "eigin"

# External (human-supplied) secrets come from .env UPSTREAM_API_KEY_PRODUCTION, MOJEEK_API_KEY_PRODUCTION (loaded via `just infra`/`tools infra tf-vars`).
# Our own secrets (relay key, token encryption key, grant keypair) are generated by Terraform.

# Provider
project_name = "eigin-production"
scw_region   = "fr-par"

# Relay: General config
max_scale                    = 3
ip_rate_limit_requests       = 500
ip_rate_limit_window_seconds = 60
# One trusted hop: Scaleway's ingress. Verify empirically before changing.
trusted_proxy_hops = 1

# Relay: Search config
monthly_pool_size = 5000

# Relay: IAP config
# Production accepts Sandbox too: TestFlight and App Review of the production app
# always operate in Sandbox. Free Sandbox issuance is bounded by the budget below.
apple_environments = ["Production", "Sandbox"]
# Comma-separated set of accepted bundle IDs. Serves the legacy alpha and the
# new App Store release at once during migration; drop the alpha once retired.
apple_bundle_id               = "com.42futures.carrel,ai.eigin.finch"
apple_app_apple_id            = ""
sandbox_monthly_credit_budget = 25000

# Relay: Inference config
admit_floor_credits             = 25
token_rate_limit_requests       = 100
token_rate_limit_window_seconds = 60

# Relay: Grants config
grant_issuer = "eigin"

# External (human-supplied) secrets come from .env MOJEEK_API_KEY_PRODUCTION, PROVIDER_*_API_KEY_PRODUCTION (loaded via `just infra`/`tools infra tf-vars`).
# Our own secrets (relay key, token encryption key, grant keypair) are generated by Terraform.

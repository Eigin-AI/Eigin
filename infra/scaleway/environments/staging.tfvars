# Provider
project_name = "eigin-staging"
scw_region   = "fr-par"

# Relay: General config
max_scale                    = 1
ip_rate_limit_requests       = 250
ip_rate_limit_window_seconds = 60
# One trusted hop: Scaleway's ingress. Verify empirically before changing.
trusted_proxy_hops = 1

# Relay: Search config
monthly_pool_size = 1000

# Relay: IAP config
# Staging is the internal dev app; all purchases are Sandbox.
apple_environments = ["Sandbox"]
# Comma-separated set of accepted bundle IDs (see production.tfvars).
apple_bundle_id               = "com.42futures.carrel.dev,ai.eigin.finch.dev"
apple_app_apple_id            = ""
sandbox_monthly_credit_budget = 5000

# Relay: Inference config
token_rate_limit_requests       = 100
token_rate_limit_window_seconds = 60

# Relay: Grants config
grant_issuer = "eigin-staging"

# External (human-supplied) secrets come from .env STAAN_API_KEY_STAGING, PROVIDER_*_API_KEY_STAGING (loaded via `just infra`/`tools config export tf-vars`).
# Our own secrets (relay key, token encryption key, grant keypair) are generated by Terraform.

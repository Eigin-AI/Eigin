{{ header }}import SwiftUI

/// App-wide typography scale. Generated from design/tokens.json.
enum Typography {
    // Use `.typography(Typography.x)` on views, or `.font(Typography.x.font)` where a bare Font is needed.
{% for style in scale.styles %}
{% if style.description %}
    /// {{ style.description }}
{% endif %}
    static let {{ style.name }} = TypographyStyle({{ style.font_expr }}{% if style.text_case %}, textCase: .{{ style.text_case }}{% endif %}{% if style.tracking != 0.0 %}, tracking: {{ style.tracking | fmt_cgfloat }}{% endif %}{% if style.line_height %}, lineHeight: {{ style.line_height | fmt_cgfloat }}{% endif %})
{% endfor %}
}

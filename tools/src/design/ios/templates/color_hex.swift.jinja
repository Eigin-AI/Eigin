{{ header }}import SwiftUI

extension Color {
    /// Initialises from a 6-character `#RRGGBB` or 8-character `#RRGGBBAA` hex string.
    init(hex: String) {
        let hex = hex.trimmingCharacters(in: CharacterSet.alphanumerics.inverted)
        var int: UInt64 = 0
        Scanner(string: hex).scanHexInt64(&int)
        if hex.count == 8 {
            let r = Double((int >> 24) & 0xFF) / 255
            let g = Double((int >> 16) & 0xFF) / 255
            let b = Double((int >> 8) & 0xFF) / 255
            let a = Double(int & 0xFF) / 255
            self.init(red: r, green: g, blue: b, opacity: a)
        } else {
            let r = Double((int >> 16) & 0xFF) / 255
            let g = Double((int >> 8) & 0xFF) / 255
            let b = Double(int & 0xFF) / 255
            self.init(red: r, green: g, blue: b)
        }
    }
}

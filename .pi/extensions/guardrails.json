{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "enabled": true,
  "applyBuiltinDefaults": true,
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      {
        "kind": "file",
        "path": "/dev/null"
      },
      {
        "kind": "file",
        "path": "/dev/zero"
      },
      {
        "kind": "file",
        "path": "/dev/random"
      },
      {
        "kind": "file",
        "path": "/dev/urandom"
      },
      {
        "kind": "file",
        "path": "/dev/stdin"
      },
      {
        "kind": "file",
        "path": "/dev/stdout"
      },
      {
        "kind": "file",
        "path": "/dev/stderr"
      },
      {
        "kind": "file",
        "path": "/dev/tty"
      },
      {
        "kind": "directory",
        "path": "/tmp"
      },
      {
        "kind": "directory",
        "path": "/private/tmp"
      },
      {
        "kind": "directory",
        "path": "/var/folders"
      },
      {
        "kind": "directory",
        "path": "~/Repositories"
      },
      {
        "kind": "directory",
        "path": "~/Library/Caches"
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": true,
    "autoDenyPatterns": [
      {
        "pattern": "\\bgit\\s+(?:-\\S+\\s+)*(?:merge|rebase|reset)\\b",
        "regex": true,
        "description": "History-rewriting/integrating git — merge, rebase, and reset stay the user's to run (they can rewrite history or disturb the main worktree). Plain `git commit` and non-force `git push` of a worktree branch are allowed. Read-only git (status/log/diff/show) is fine."
      },
      {
        "pattern": "\\bgit\\s+push\\b.*(?:--force\\b|--force-with-lease\\b|(?:^|\\s)-f\\b)",
        "regex": true,
        "description": "Force push — never. Regular commit/push of a worktree branch is fine, but force-pushing can clobber history. `main` is additionally protected server-side (no direct or force push; merge via MR only)."
      },
      {
        "pattern": "\\bgit\\s+branch\\s+(?:\\S+\\s+)*-(?:d|D|m|M|f)\\b",
        "regex": true,
        "description": "Git branch delete/rename — branch changes are the user's to run."
      },
      {
        "pattern": "\\bgit\\s+remote\\s+(?:add|remove|rm|rename|set-url|set-head|prune)\\b",
        "regex": true,
        "description": "Git remote mutation — the user manages remotes themselves."
      },
      {
        "pattern": "\\b(?:terraform|tofu)\\s+(?:apply|destroy)\\b",
        "regex": true,
        "description": "Terraform/OpenTofu apply or destroy — infra changes are the user's to run. `terraform plan` is fine."
      },
      {
        "pattern": "\\bjust\\s+(?:-\\S+\\s+)*infra\\s+deploy\\b",
        "regex": true,
        "description": "`just infra deploy` wraps `terraform apply` and deploys infra — this is the user's to run. `just infra plan`/`init` are fine."
      }
    ]
  },
  "version": "0.16.2"
}

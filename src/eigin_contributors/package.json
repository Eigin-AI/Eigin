{
  "name": "@eigin/contributors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && npm run build",
    "test:e2e": "playwright test",
    "prepare:website": "npm exec --workspace @eigin/website -- svelte-kit sync",
    "predev": "npm run prepare:website",
    "precheck": "npm run prepare:website",
    "prebuild": "npm run prepare:website",
    "db:migrate": "node scripts/migrate.ts",
    "db:prune-oauth": "node scripts/prune-oauth-attempts.ts",
    "test:auth": "node --test tests/auth.test.ts tests/sign-in-limit.test.ts",
    "test:submissions": "node --test tests/submissions.test.ts",
    "test:review": "node --test tests/review.test.ts",
    "test:selection": "node --test tests/selection.test.ts",
    "test:publication": "node --test tests/publication.test.ts",
    "test:production": "node scripts/smoke-production.ts",
    "test:content": "node --test tests/foldouts.test.ts"
  },
  "dependencies": {
    "@eigin/ui": "*",
    "@eigin/website": "*",
    "fflate": "0.8.3",
    "marked": "^17.0.6",
    "pg": "^8.23.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^6.0.4",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.4",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}

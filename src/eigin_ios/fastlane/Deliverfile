# app_identifier is a placeholder; sync_metadata always passes the actual
# per-env bundle id explicitly (see Fastfile's `profile`), overriding this.
app_identifier ENV.fetch("BUNDLE_ID")
metadata_path "./fastlane/metadata"
# Screenshot behavior is per lane: `sync_metadata` keeps skip_screenshots: true;
# `sync_screenshots` uploads everything in fastlane/screenshots via deliver.

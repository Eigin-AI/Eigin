# SwiftFormat configuration for Eigin
--swiftversion 6.0
--indent 4
--maxwidth 100
--commas always
--importgrouping alpha
--organizetypes class,struct,enum,extension
--organizationmode type
--wraparguments before-first
--wrapcollections before-first
--ifdef outdent
--stripunusedargs closure-only
--patternlet inline
# Packages/LiteRTLM is vendored third-party code kept verbatim for clean
# upstream diffing on version bumps; do not reformat it to our style.
--exclude .build,Frameworks,Packages/LiteRTLM
--disable preferKeyPath,redundantSendable

    "settings.proactivity.balanced.description" : {
      "comment" : "Full description of the balanced proactivity mode",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgår af og til erindringer og nylige samtaler. Giver kun besked, når der er noget værd at dele."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occasionally reviews memories and recent chats. Notifies only when it has something genuinely worth sharing."
          }
        }
      }
    },
    "settings.proactivity.balanced.short" : {
      "comment" : "Short one-line summary of the balanced proactivity mode",
      "localizations" : {
        "da" : {
          "stringUnit" : {

        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's give your AI a name. How about one of these: %@? Or suggest your own."
          }
        }
      }
    },
    "onboarding.chat.powerExplanation" : {
      "comment" : "Upgrade pitch for users who chose power priority.",
      "localizations" : {
        "da" : {
          "stringUnit" : {

    "onboarding.name.privacySheetText" : {
      "comment" : "Body text in the privacy explanation sheet on the name screen.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt du fortæller mig, gemmes på din enhed og ingen andre steder. \n\nHvis du ikke vil dele dit rigtige navn, er det også fint. Brug et kælenavn, et initial, eller skriv bare „Anonym“. Det er op til dig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you tell me is stored on your device, and nowhere else. \n\nIf you’d rather not share your real name, that’s also okay. Use a nickname, an initial, or just write “Anonymous”. It’s up to you."
          }
        }
      }
    },

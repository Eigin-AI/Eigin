    "onboarding.chat.aboutYouPrompt" : {
      "comment" : "Recovery opener for the about stage, used when the previous stage failed to extract a name.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videre — fortæl mig lidt om dig selv. Hvad laver du, eller hvad betyder noget for dig?"
          }

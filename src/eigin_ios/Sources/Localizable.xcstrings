    },
    "onboarding.chat.choiceExplanation" : {
      "comment" : "Upgrade pitch for users who chose freedom priority.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da du vægter valgfrihed, kan du forbinde cloud AI for den fulde oplevelse eller fortsætte lokalt. Du bestemmer, hvilken model der håndterer hvilken opgave."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since you value choice, you can connect cloud AI for the full experience or stick with the local model. You decide which model handles which tasks."
          }
        }
      }
    },
    "onboarding.chat.firstChatTitle" : {
      "comment" : "Title of the first chat created at the end of onboarding.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vores første samtale"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our first chat"
          }
        }
      }
    },
    "onboarding.chat.initialGreeting" : {
      "comment" : "The onboarding greeting shown as the first message in the guided conversation.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej! Jeg er helt ny — intet navn, ingen hukommelse, ingenting endnu.\n\nJeg vil gerne lære dig lidt at kende, så jeg kan indstille mig selv til at være den rette assistent for dig. Det tager kun et par minutter.\n\nHvad hedder du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! I'm brand new — no name, no memory, nothing yet.\n\nI'd love to learn a bit about you so I can set myself up to be the right assistant for you. It should only take a few minutes.\n\nWhat's your name?"
          }
        }
      }
    },
    "onboarding.chat.localExplanation" : {
      "comment" : "Upgrade pitch for users who chose privacy priority.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ starter offline, på din enhed. Forbind cloud AI, når du er klar, for at låse op for appens fulde kraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ starts offline, on your device. Connect cloud AI when you're ready to unlock the full power of the app."
          }
        }
      }
    },
    "onboarding.chat.namePrompt" : {
      "comment" : "Recovery opener for the agent name stage, used when the previous stage failed to extract priority. The argument is a comma-separated list of suggested names.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad os give din AI et navn. Hvad med et af disse: %@? Eller foreslå dit eget."

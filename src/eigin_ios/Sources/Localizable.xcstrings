            "value" : "Deler lejlighedsvis tanker, der er værd at høre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occasionally shares thoughts worth hearing."
          }
        }
      }
    },
    "settings.proactivity.proactive.description" : {
      "comment" : "Full description of the high proactivity mode",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgår og reflekterer regelmæssigt over erindringer og samtaler. Mere villig til at dele tanker og observationer."

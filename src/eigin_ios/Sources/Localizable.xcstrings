    "onboarding.flow.inference.text" : {
      "comment" : "Avatar speech body on the inference screen.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kan tænke med kraftfuld AI i skyen, hostet i Europa.\n\nEller kan jeg køre på din enhed. Du kan ændre dette når som helst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can think with powerful AI in the cloud, hosted in Europe.\n\nOr I can run on your device. You can change this anytime."
          }
        }
      }
    },
    "onboarding.flow.inference.title" : {
      "comment" : "Avatar speech title on the inference screen.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu skal jeg have en hjerne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now, let’s give me a brain."
          }
        }
      }
    },
    "onboarding.flow.initiative.text" : {
      "comment" : "Avatar speech body on the initiative screen.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kan blive ved med at arbejde, når du er væk, lede efter ting der er din opmærksomhed værd og række ud af og til.\n\nEller kan jeg være stille og kun hjælpe, når du spørger. Det er op til dig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can keep working when you’re away, looking for things worth your attention and reaching out now and then.\n\nOr I can stay quiet and only help when you ask. Your call."
          }
        }
      }
    },
    "onboarding.flow.initiative.title" : {
      "comment" : "Avatar speech title on the initiative screen.",

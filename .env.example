# Secrets and per-contributor values. Run `just config init` to create your .env
# from this file, then fill in what you need.
#
# Shared configuration lives in config/, not here: app values in config/app.toml,
# infra values in infra/scaleway/environments/*.tfvars.
#
# Run `just config` to see what's ready and what's still missing.

# ------ SECRETS ------------------------

# Search config
export STAAN_API_KEY_STAGING=YOUR_SECRET_KEY
export STAAN_API_KEY_PRODUCTION=YOUR_SECRET_KEY

# Inference config (one per provider, matching providers.toml)
export PROVIDER_MISTRAL_API_KEY_STAGING=YOUR_SECRET_KEY
export PROVIDER_MISTRAL_API_KEY_PRODUCTION=YOUR_SECRET_KEY
export PROVIDER_TENSORX_API_KEY_STAGING=YOUR_SECRET_KEY
export PROVIDER_TENSORX_API_KEY_PRODUCTION=YOUR_SECRET_KEY

# Relay key, baked into the app so it can access the relay
export EIGIN_RELAY_PRIMARY_KEY_STAGING=YOUR_SECRET_KEY
export EIGIN_RELAY_PRIMARY_KEY_PRODUCTION=YOUR_SECRET_KEY

# Optional previous keys, accepted during a rotation
# export EIGIN_RELAY_SECONDARY_KEY_STAGING=PREVIOUS_KEY
# export EIGIN_RELAY_SECONDARY_KEY_PRODUCTION=PREVIOUS_KEY
# export TOKEN_ENCRYPTION_SECONDARY_KEY_STAGING=PREVIOUS_KEY
# export TOKEN_ENCRYPTION_SECONDARY_KEY_PRODUCTION=PREVIOUS_KEY

# Terraform remote state backend (output of `just infra bootstrap`)
# export TFSTATE_ACCESS_KEY=YOUR_ACCESS_KEY
# export TFSTATE_SECRET_KEY=YOUR_SECRET_KEY
# export TFSTATE_REGION=fr-par

# ------ PER-CONTRIBUTOR ----------------

# Your Apple team
export DEVELOPMENT_TEAM=YOUR_TEAM_ID

# ------ RELEASE ONLY -------------------

# App Store Connect API key (fastlane). .p8 goes in
# src/eigin_ios/fastlane/AuthKey/ (gitignored) — see its README.
# export ASC_KEY_ID=YOUR_KEY_ID
# export ASC_ISSUER_ID=YOUR_ISSUER_ID
# export ASC_KEY_PATH=fastlane/AuthKey/AuthKey_YOUR_KEY_ID.p8

# App Review contact (fastlane: sync_metadata). Falls back to bogus defaults
# if unset; set real values before an actual App Store submission.
# export APP_REVIEW_FIRST_NAME=YOUR_FIRST_NAME
# export APP_REVIEW_LAST_NAME=YOUR_LAST_NAME
# export APP_REVIEW_PHONE_NUMBER="+45 12 34 56 78"

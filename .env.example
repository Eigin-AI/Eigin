# ------ RELAY ------------------------

# Search config
export MOJEEK_API_KEY_STAGING=YOUR_SECRET_KEY
export MOJEEK_API_KEY_PRODUCTION=YOUR_SECRET_KEY

# Inference config (one per provider, matching providers.toml)
export PROVIDER_BERGET_API_KEY_STAGING=YOUR_SECRET_KEY
export PROVIDER_BERGET_API_KEY_PRODUCTION=YOUR_SECRET_KEY
export PROVIDER_MISTRAL_API_KEY_STAGING=YOUR_SECRET_KEY
export PROVIDER_MISTRAL_API_KEY_PRODUCTION=YOUR_SECRET_KEY

# Optional previous key, accepted during a rotation
# export EIGIN_RELAY_SECONDARY_KEY_STAGING=PREVIOUS_KEY
# export EIGIN_RELAY_SECONDARY_KEY_PRODUCTION=PREVIOUS_KEY

# ------ APPS ------------------------

# Relay config
export EIGIN_RELAY_URL_STAGING=https://staging.relay.eigin.ai
export EIGIN_RELAY_URL_PRODUCTION=https://relay.eigin.ai
export EIGIN_RELAY_PRIMARY_KEY_STAGING=YOUR_SECRET_KEY
export EIGIN_RELAY_PRIMARY_KEY_PRODUCTION=YOUR_SECRET_KEY

# Apple config
export DEVELOPMENT_TEAM=YOUR_TEAM_ID
export BUNDLE_ID=ai.eigin.finch

# App Store Connect API key (fastlane). .p8 goes in
# src/eigin_ios/fastlane/AuthKey/ (gitignored) — see its README.
export ASC_KEY_ID=YOUR_KEY_ID
export ASC_ISSUER_ID=YOUR_ISSUER_ID
export ASC_KEY_PATH=fastlane/AuthKey/AuthKey_YOUR_KEY_ID.p8

# App Review contact (fastlane: sync_metadata). Falls back to bogus defaults
# if unset; set real values before an actual App Store submission.
export APP_REVIEW_FIRST_NAME=YOUR_FIRST_NAME
export APP_REVIEW_LAST_NAME=YOUR_LAST_NAME
export APP_REVIEW_PHONE_NUMBER="+45 12 34 56 78"

# Google config
export EIGIN_GOOGLE_OAUTH_CLIENT_ID_STAGING=YOUR_GOOGLE_OAUTH_ID
export EIGIN_GOOGLE_OAUTH_CLIENT_ID_PRODUCTION=YOUR_GOOGLE_OAUTH_ID

# Microsoft config
export EIGIN_MICROSOFT_OAUTH_CLIENT_ID_STAGING=YOUR_MICROSOFT_OAUTH_ID
export EIGIN_MICROSOFT_OAUTH_CLIENT_ID_PRODUCTION=YOUR_MICROSOFT_OAUTH_ID

# Aula config (Aula's own mobile-app OAuth client id, not one we register)
export EIGIN_AULA_OAUTH_CLIENT_ID_STAGING=YOUR_AULA_OAUTH_ID
export EIGIN_AULA_OAUTH_CLIENT_ID_PRODUCTION=YOUR_AULA_OAUTH_ID

# Support email
export EIGIN_SUPPORT_EMAIL=support@eigin.ai

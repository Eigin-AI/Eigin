{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": [
      "vite/client"
    ],
    "paths": {
      "@lib": [
        "src/lib/index.ts"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@gallery/*": [
        "src/gallery/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
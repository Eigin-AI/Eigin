schema actor {
    field {
        name = "name"
        type = "string"
        required = true
    }
    field {
        name = "type"
        type = "enum"
        allowed_values = ["human", "ai", "organization", "other"]
        required = false
    }
    field {
        name = "tags"
        type = "list"
        required = false
    }
    field {
        name = "created_at"
        type = "datetime"
        required = false
    }
    field {
        name = "relates_to"
        type = "list"
        required = false
    }
    field {
        name = "belongs_to"
        type = "list"
        required = false
    }
    field {
        name = "uses"
        type = "list"
        required = false
    }
    field {
        name = "describes"
        type = "list"
        required = false
    }
    field {
        name = "supersedes"
        type = "list"
        required = false
    }
}

schema thing {
    field {
        name = "name"
        type = "string"
        required = true
    }
    field {
        name = "category"
        type = "enum"

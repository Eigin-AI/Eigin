fact eigin_agent_tab_review {
    name = "Reviewing Agent Data"
    claim = "Everything your agent stores can be reviewed in the Agent tab, under its advanced section: its core texts, its knowledge, its intents, and the skills it has. You can read all of it, and edit or delete what the agent has saved about you, so what it knows and works from is always open to you and in your control."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_tab, fact.eigin_agent_has_core_texts, fact.eigin_agent_has_knowledge, fact.eigin_agent_has_intents, fact.eigin_agent_has_skills]
    tags = ["agent", "data", "review", "advanced", "core texts", "knowledge", "intents", "skills", "edit", "delete", "transparency", "control"]
    created_at = 2025-03-12
    last_verified = 2026-10-08
}

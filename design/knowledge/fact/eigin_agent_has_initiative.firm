fact eigin_agent_has_initiative {
    name = "Initiatives"
    claim = "Initiatives are agreed recurring invitations to interact about things the user cares about, linked to the agent's intents. They let the agent schedule notifications for a daily news overview, a weekly check-in, or other recurring conversations. The user and agent agree what to reach out about and when. Opening an invitation starts current work in a chat. Notifications invite that interaction; they do not imply work has already finished. Invitations currently support daily or weekly schedules, including selected weekdays, and follow the device's time zone. Delivery depends on notification permission and settings. Agreed initiatives work independently of background preparation and remain available in reactive mode."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_has_intents, fact.eigin_agent_does_background_work]
    tags = ["initiative", "initiatives", "reminders", "notifications", "recurring", "daily", "weekly", "weekdays", "news", "check-in", "schedule", "agreement", "permission"]
    created_at = 2025-03-11
    last_verified = 2026-11-06
}

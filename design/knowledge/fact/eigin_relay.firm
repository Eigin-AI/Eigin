fact eigin_relay {
    name = "Eigin Relay"
    claim = "Eigin Relay is a service that helps the agent do things it can't manage on your device alone. It offers cloud AI, a way to use capable models without creating an account or bringing a provider key, and it hosts the local models and voices you can download. It also provides connectivity services such as web search. It runs on European infrastructure with zero data retention, built around privacy and GDPR."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_ai_providers, fact.eigin_bring_your_own_key, fact.eigin_is_private_ai, fact.eigin_relay_models, fact.eigin_relay_credits]
    tags = ["relay", "eigin relay", "connectivity", "web search", "cloud ai", "inference", "anonymous", "europe", "european", "gdpr", "privacy", "zero data retention", "keys", "downloads"]
    created_at = 2026-07-03
    last_verified = 2026-10-08
}

fact eigin_settings_tab {
    name = "Settings Tab"
    claim = "The Settings tab holds the configuration only you can change. From here you can change the language, set tool permissions for each tool, add connections such as AI providers and MCP servers, and open advanced settings for things like logging, troubleshooting, and managing local models."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_app_tabs, fact.eigin_tool_permissions, fact.eigin_ai_providers, fact.eigin_extends_with_mcp, fact.eigin_language_support, fact.eigin_feedback]
    tags = ["navigation", "settings", "tab", "language", "permissions", "connections", "providers", "mcp", "local models", "advanced", "logging", "feedback"]
    created_at = 2025-03-12
    last_verified = 2026-07-03
}

fact eigin_local_model {
    name = "Local Model"
    claim = "You can run the agent on a model that lives entirely on your device: Gemma 4 E2B, which requires an iPhone 15 or later. Download it from Connections in the Settings tab, or from Local Assets under Settings, Advanced. It gives you solid conversation and general knowledge, and can still draw on web search and your knowledge to look things up. But it works with a limited set of tools, and a smaller context window means it may lose track of earlier details as a chat goes on. Best when you're offline or want guaranteed privacy, with nothing leaving your device at all."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_ai_providers, fact.eigin_on_device_processing, fact.eigin_is_private_ai, fact.eigin_connections, fact.eigin_model_routing]
    tags = ["local", "local model", "gemma", "iphone 15", "on-device", "offline", "privacy", "download", "settings", "connections", "local assets", "tools", "context window", "forget", "fallback", "stand-in"]
    created_at = 2026-07-04
    last_verified = 2026-10-08
}

fact eigin_chat_actions {
    name = "Chat Actions"
    claim = "In a chat, the plus button opens contextual actions, such as taking a photo, attaching an image, or moving the chat to a space. What's offered depends on the model and the chat. For example, image options only appear if the model you're using supports vision; with automatic model selection they're available whenever your provider has a model that does. The microphone button lets you dictate instead of typing, and the phone button starts a live call for a hands-free, spoken conversation."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_chat_tab, fact.eigin_live_call, fact.eigin_spaces_organize_context, fact.eigin_image_input, fact.eigin_voice_is_core, fact.eigin_model_routing]
    tags = ["chat", "actions", "plus button", "move", "space", "attach", "image", "photo", "vision", "dictation", "microphone", "voice", "live call", "phone", "hands-free"]
    created_at = 2025-03-12
    last_verified = 2026-10-08
}

fact eigin_on_device_processing {
    name = "On-Device Processing"
    claim = "Dictation, text-to-speech, and embeddings all run on-device. Data only leaves the device for something you chose: the AI model you picked, an integration you added, or connectivity features like web search offered via Eigin Relay."

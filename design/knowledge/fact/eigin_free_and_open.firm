fact eigin_free_and_open {
    name = "Free and Open Source"
    claim = "The Eigin app is free, and its code is open source, licensed under AGPL and available at code.eigin.ai. It's funded by offering European private AI inference as a service to everyone, with a small margin on top, and by offering additional services to organisations that want to roll out private, safe agents to their teams."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_cost_model, fact.eigin_relay]
    tags = ["free", "open source", "agpl", "license", "code", "funding", "sovereign", "organisations", "pricing"]
    created_at = 2025-03-11
    last_verified = 2026-10-08
}

fact eigin_platforms {
    name = "Platform Availability"
    claim = "Eigin is available on iOS and Apple Watch. There is also a widget you can put on your home screen, and Siri Shortcuts. It is not available on macOS, Android, or other platforms yet, but we're working on expanding Eigin to more platforms in the future."

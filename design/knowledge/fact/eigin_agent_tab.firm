fact eigin_agent_tab {
    name = "Agent Tab"
    claim = "The Agent tab is where you change your agent yourself — its name, look, and voice, and which AI provider and model it runs on. For most of this you don't need the tab at all: you can simply ask the agent to change it. But when you'd rather do it by hand, this is the place."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_app_tabs, fact.eigin_ai_providers, fact.eigin_agent_self_configurable]
    tags = ["navigation", "agent", "tab", "name", "voice", "presentation", "provider", "model", "configure"]
    created_at = 2025-03-12
    last_verified = 2026-07-03
}

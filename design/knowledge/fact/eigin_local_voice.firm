fact eigin_local_voice {
    name = "Local Voice"
    claim = "The agent can speak aloud. Out of the box it uses your device's built-in text-to-speech, and Eigin also offers an improved voice model that sounds much more natural and runs entirely on your device, for every supported language. You're offered the download the first time you're about to use voice, and it shows up as a suggestion in the Agent tab. If you decline and want it later, go to Settings, Advanced, Local Assets and download it from there."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_voice_is_core, fact.eigin_agent_tab, fact.eigin_settings_tab, fact.eigin_on_device_processing]
    tags = ["voice", "text-to-speech", "tts", "speech", "voice model", "download", "local", "on-device", "agent tab", "settings", "local assets", "offline", "languages", "speaking"]
    created_at = 2026-07-03
    last_verified = 2026-10-08
}

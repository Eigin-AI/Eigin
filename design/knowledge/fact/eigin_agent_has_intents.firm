fact eigin_agent_has_intents {
    name = "Intents"
    claim = "Intents are the agent's goals — things it is working toward for you, carried across conversations rather than forgotten when a chat ends. It sets them itself, keeps them current, and resolves them once they're met. An intent can hold tasks, dated events, and recurring schedules. Events and schedules influence how intents are ranked over time, helping relevant goals surface in the user's conversations with the agent. Initiatives provide separately agreed scheduled notifications and invitations to interact about those goals."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_has_initiative, fact.eigin_agent_has_knowledge]
    tags = ["intents", "goals", "tasks", "reminders", "schedules", "events", "initiative", "proactive", "tracking", "follow-up", "notifications"]
    created_at = 2026-07-03
    last_verified = 2026-11-06
}

fact eigin_not_just_a_wrapper {
    name = "More Than an AI Wrapper"
    claim = "It's fair to ask whether Eigin is just a wrapper over someone else's AI API. It isn't. The model that answers you is one part of a much larger system: your agent has its own identity and principles, a knowledge base it builds about you, intents it carries between chats, skills and tools it can reach for, and context management that holds all of this together across every conversation. You can even swap the model underneath and the agent stays the same. The model is a component Eigin uses, not the thing you're really using."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_vs_chatgpt_claude_gemini, fact.eigin_agent_has_core_texts, fact.eigin_agent_has_knowledge, fact.eigin_agent_has_intents, fact.eigin_ai_providers]
    tags = ["wrapper", "api", "skeptic", "just a wrapper", "agent", "system", "model", "component", "identity", "knowledge", "intents", "skills", "context", "persistent", "difference"]
    created_at = 2026-07-04
    last_verified = 2026-10-08
}

fact eigin_relay_credit_pricing {
    name = "Relay Credit Pricing"
    claim = "An Eigin Relay credit is worth roughly one euro cent of AI inference at cost — the real price the providers charge. Eigin's cloud AI draws on several European providers, hosted by European-owned companies, so you get a good catalogue of models. The packs cost a little more than the inference inside them: a fee is added when you buy, most of which is the app store's cut on the in-app purchase, plus a small margin to help Eigin cover running the infrastructure. You pay that once, up front — from then on each credit spends at cost."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_relay_credits, fact.eigin_relay, fact.eigin_cost_model]
    tags = ["credits", "pricing", "cost", "euro", "inference", "european", "providers", "fee", "app store", "in-app purchase", "margin", "transparency"]
    created_at = 2026-07-03
}

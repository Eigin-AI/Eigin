fact eigin_agent_has_skills {
    name = "Skills"
    claim = "The agent's capabilities are organised into skills. Each skill bundles a set of instructions with the tools those instructions need, so turning one on both teaches the agent how to do something and gives it the means. The agent has a catalog of skills available to it. It's hinted about which ones might be relevant at any given moment, and when it needs a capability it doesn't have loaded, it can search the catalog and activate the skill it needs. Some skills are always active in every conversation. You can also just ask the agent what it can do."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_has_knowledge, fact.eigin_agent_has_initiative, fact.eigin_agent_self_configurable, fact.eigin_voice_is_core, fact.eigin_integrations, fact.eigin_step_by_step_flows]
    tags = ["skills", "capabilities", "tools", "activate", "search", "catalog", "hints", "always active", "abilities"]
    created_at = 2026-04-12
    last_verified = 2026-10-08
}

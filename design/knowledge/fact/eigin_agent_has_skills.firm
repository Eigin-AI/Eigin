fact eigin_agent_has_skills {
    name = "Skills"
    claim = "The agent's capabilities are organised into skills. Each skill bundles a set of instructions with the tools those instructions need, so turning one on both teaches the agent how to do something and gives it the means. Some skills are always active, ready in every conversation; others activate on demand — the agent enables one when it recognises the need, or you can ask for it. The agent always has its current skills in view, so if you want to know what it can do right now, just ask."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_has_knowledge, fact.eigin_agent_has_initiative, fact.eigin_agent_self_configurable, fact.eigin_voice_is_core]
    tags = ["skills", "capabilities", "tools", "activate", "on-demand", "always active", "abilities"]
    created_at = 2026-04-12
    last_verified = 2026-07-03
}

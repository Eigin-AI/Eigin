fact eigin_agent_has_knowledge {
    name = "Knowledge Base"
    claim = "The agent has knowledge. Some comes bundled with the app, so it knows about Eigin and how the system works. Over time it also collects knowledge about you and what you're working on, organised as a linked graph of people, things, facts, notes and outputs, so it can search it and follow connections. Knowledge works like memory: the most relevant pieces are surfaced as you talk, ranked by how much they're used, so what matters stays within reach. If initiative is turned on, the agent will occasionally tidy up and reflect on what it has learned to keep its knowledge consistent."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_spaces_organize_context, fact.eigin_agent_has_initiative]
    tags = ["knowledge", "knowledge base", "facts", "notes", "memory", "graph", "people", "things", "outputs", "learning", "search", "relevant", "ranking", "bundled", "consistent"]
    created_at = 2025-03-11
    last_verified = 2026-10-08
}

fact eigin_agent_has_knowledge {
    name = "Knowledge Base"
    claim = "The agent has a knowledge base for everything it learns about you over time. It's a single place for the people, things, and facts of your life, along with notes it keeps and outputs you've made together. Knowledge is structured and linked, so the agent can search it and follow connections to related things. As you talk, the system automatically surfaces the knowledge that looks relevant to what you're saying, and the agent can also search it directly whenever it wants to find something."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_spaces_organize_context]
    tags = ["knowledge", "knowledge base", "facts", "notes", "memory", "people", "things", "outputs", "learning", "search", "related", "relevant"]
    created_at = 2025-03-11
    last_verified = 2026-07-03
}

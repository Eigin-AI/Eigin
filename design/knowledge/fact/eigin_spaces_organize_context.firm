fact eigin_spaces_organize_context {
    name = "Spaces"
    claim = "Spaces group your chats by context, such as work, personal, or a project. A space can have its own instructions for how the agent should behave or what it should be aware of when you're in it. By default the agent can draw on everything it knows, whatever space you're in. You can also make a space private: knowledge the agent picks up there isn't available globally or in other spaces, and private chats are hidden from the chat list unless you select that space."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_has_knowledge, fact.eigin_chat_tab]
    tags = ["spaces", "context", "organization", "private", "privacy", "isolation", "instructions", "knowledge", "scope", "hidden", "domains"]
    created_at = 2025-03-11
    last_verified = 2026-10-08
}

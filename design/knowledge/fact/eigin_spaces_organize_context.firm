fact eigin_spaces_organize_context {
    name = "Spaces"
    claim = "Spaces group your chats by context, such as work, personal, or a project. By default the agent can draw on everything it knows, whatever space you're in. You can also make a space private: knowledge the agent builds up there stays inside it and can't be reached from other spaces. That knowledge is only available when you're in that space."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_agent_has_knowledge]
    tags = ["spaces", "context", "organization", "private", "privacy", "isolation", "knowledge", "scope", "domains"]
    created_at = 2025-03-11
    last_verified = 2026-07-03
}

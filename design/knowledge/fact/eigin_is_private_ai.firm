fact eigin_is_private_ai {
    name = "Private and Local-First"
    claim = "Eigin is a private, local-first AI app, with no tracking and no hidden incentives. Your data stays on your device, and it only leaves for something you chose: what the agent sends to your AI provider, a service you connected, or a Relay feature like web search. If your provider is Eigin Relay, it goes to European providers only, with zero data retention. If it's a local model, nothing leaves your device for inference at all. Privacy, security, and ownership are principles the whole app is built on, and it shows in how it works."
    source = enum"stated"
    describes = [thing.eigin]
    relates_to = [fact.eigin_on_device_processing, fact.eigin_respects_os_security, fact.eigin_free_and_open, fact.eigin_relay]
    tags = ["privacy", "private", "local-first", "data", "security", "ownership", "no tracking", "on-device", "relay", "european", "zero data retention", "local model"]
    created_at = 2025-03-11
    last_verified = 2026-10-08
}

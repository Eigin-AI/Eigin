          "desktop": { "$type": "dimension", "$value": "{grid.desktop.inner}" }
        }
      },
      "contentGrouping": {
        "gap": { "$type": "dimension", "$value": "{spacing.n8}" },
        "px": {
          "mobile": { "$type": "dimension", "$value": "{grid.mobile.outer}" },
          "tablet": { "$type": "dimension", "$value": "{grid.tablet.outer}" },
          "desktop": { "$type": "dimension", "$value": "{grid.desktop.outer}" }
        }
      }
    },
    "card": {
      "px": {
        "small": { "$type": "dimension", "$value": "{spacing.n8}" },
        "large": { "$type": "dimension", "$value": "{spacing.n32}" }
      },
      "py": {
        "small": { "$type": "dimension", "$value": "{spacing.n16}" },
        "top": { "$type": "dimension", "$value": "{spacing.n8}" },
        "bottom": { "$type": "dimension", "$value": "{spacing.n32}" },
        "compact": { "$type": "dimension", "$value": "{spacing.n24}" }
      },
      "gap": {
        "text": { "$type": "dimension", "$value": "{spacing.n16}" },
        "textCompact": { "$type": "dimension", "$value": "{spacing.n12}" },
        "imageText": { "$type": "dimension", "$value": "{spacing.n24}" }
      },
      "image": {
        "largeRatio": { "$type": "number", "$value": 1.5 },
        "smallRatio": { "$type": "number", "$value": 0.75 }
      }
    },
    "image": {
      "$description": "Images rendered inside a conversation.",
      "height": {
        "$type": "dimension",
        "$value": "182px",
        "$description": "Every chat image is this tall, whatever it turns out to be. Seven lines of chat text, which is 16:9 across the mobile chat column."
      },
      "icon": {
        "cover": {
          "$type": "dimension",
          "$value": "32px",
          "$description": "Cover glyph on a withheld or failed image card."
        },
        "badge": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Globe inside the linked-image host badge."
        },
        "ring": {
          "$type": "dimension",
          "$value": "40px",
          "$description": "Sweep ring while an image card is loading."
        }
      },
      "badgeHostMinWidth": {
        "$type": "dimension",
        "$value": "220px",
        "$description": "Below this card width the host text is a stub worth nothing; the globe alone says the image leads somewhere."
      },
      "ratio": {
        "placeholder": {
          "$type": "number",
          "$value": 1,
          "$description": "Shape held before the image arrives. Square: it commits to nothing, so settling into the real shape reads as the image arriving rather than a correction."
        },
        "max": {
          "$type": "number",
          "$value": 2,
          "$description": "The widest a chat image gets: past the chat column on a phone, so a wide image simply fills it."
        },
        "min": {
          "$type": "number",
          "$value": 0.75,
          "$description": "Narrowest a chat image gets: a tall image stops here rather than becoming a sliver."
        }
      }
    }

  "motion": {
    "$description": "Animation speed tiers, shared by every platform. Presets (springs, easing curves) stay platform-level.",
    "fast": {
      "$type": "duration",
      "$value": "150ms",
      "$description": "Instant feedback \u2014 button highlights, toggle flips, icon swaps."
    },
    "normal": {
      "$type": "duration",
      "$value": "250ms",
      "$description": "Standard transitions \u2014 reveals, slides, size changes."
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms",
      "$description": "Deliberate motion \u2014 view transitions, modals, onboarding."
    },
    "easing": {
      "$description": "Named curves for the platform animation presets. Springs are approximated as cubic beziers on platforms that lack them.",
      "smooth": {
        "$type": "cubicBezier",
        "$value": [0.42, 0, 0.58, 1],
        "$description": "Standard ease-in-out \u2014 reveals, expansions, size changes."
      },
      "snap": {
        "$type": "cubicBezier",
        "$value": [0.34, 1.26, 0.64, 1],
        "$description": "Snappy with a slight overshoot \u2014 buttons, chips, icons."

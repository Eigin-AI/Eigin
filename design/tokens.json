{
  "$modes": {
    "light": {},
    "dark": { "$fallback": "light" }
  },
  "palette": {
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "grey": {
      "950": { "$type": "color", "$value": "#2E2D2B" },
      "900": { "$type": "color", "$value": "#323331" },
      "800": { "$type": "color", "$value": "#4C4C4A" },
      "700": { "$type": "color", "$value": "#656562" },
      "600": { "$type": "color", "$value": "#7E7F7B" },
      "400": { "$type": "color", "$value": "#BABAB7" },
      "200": { "$type": "color", "$value": "#DCDDDB" },
      "100": { "$type": "color", "$value": "#EAEAE9" },
      "50": { "$type": "color", "$value": "#E7E7E7" },
      "25": { "$type": "color", "$value": "#F5F5F5" },
      "10": { "$type": "color", "$value": "#F9F9F9" }
    },
    "brown": {
      "900": { "$type": "color", "$value": "#3C3228" },
      "850": { "$type": "color", "$value": "#3E3D39" },
      "800": { "$type": "color", "$value": "#5A4C3D" },
      "700": { "$type": "color", "$value": "#776551" },
      "500": { "$type": "color", "$value": "#C0A88F" },
      "400": { "$type": "color", "$value": "#B29779" },
      "300": { "$type": "color", "$value": "#D9CBBC" },
      "200": { "$type": "color", "$value": "#E6DCD2" },
      "100": { "$type": "color", "$value": "#F0EAE4" }
    },
    "green": {
      "primary": { "$type": "color", "$value": "#757B3E" }
    },
    "orange": {
      "primary": { "$type": "color", "$value": "#FE6C3B" }
    },
    "rose": {
      "primary": { "$type": "color", "$value": "#DB7D7F" }
    },
    "amber": {
      "primary": { "$type": "color", "$value": "#FCAF53" }
    },
    "blush": {
      "primary": { "$type": "color", "$value": "#FAC2D5" }
    },
    "red": {
      "primary": { "$type": "color", "$value": "#CC4033" },
      "light": { "$type": "color", "$value": "#FF7845" }
    }
  },
  "color": {
    "background": {
      "$type": "color",
      "$value": "{palette.grey.50}",
      "$modes": { "dark": "{palette.grey.950}" },
      "$description": "App background — the canvas behind all content."
    },
    "surface": {
      "$type": "color",
      "$value": "{palette.grey.25}",
      "$modes": { "dark": "{palette.brown.850}" },
      "$description": "Elevated surface — cards, sheets, popups, and user message bubbles."
    },
    "surfaceSecondary": {
      "$type": "color",
      "$value": "{palette.brown.200}",
      "$modes": { "dark": "{palette.brown.800}" },
      "$description": "Secondary surface — subtle grouped backgrounds."
    },
    "textPrimary": {
      "$type": "color",
      "$value": "{palette.grey.950}",
      "$modes": { "dark": "{palette.grey.10}" },
      "$description": "Primary label and body text."
    },
    "textSecondary": {
      "$type": "color",
      "$value": "{palette.grey.700}",
      "$modes": { "dark": "{palette.brown.300}" },
      "$description": "Supporting text and secondary labels."
    },
    "textTertiary": {
      "$type": "color",
      "$value": "{palette.grey.600}",
      "$modes": { "dark": "{palette.brown.500}" },
      "$description": "Placeholder, hint, and disabled text."
    },
    "accent": {
      "$type": "color",
      "$value": "{palette.brown.400}",
      "$description": "Primary interactive accent — buttons, links, highlights."
    },
    "accentSecondary": {
      "$type": "color",
      "$value": "{palette.orange.primary}",
      "$description": "Secondary accent — energetic CTA and emphasis."
    },
    "border": {
      "$type": "color",
      "$value": "{palette.brown.300}",
      "$modes": { "dark": "{palette.grey.800}" },
      "$description": "Dividers, input borders, and separators."
    },
    "destructive": {
      "$type": "color",
      "$value": "{palette.red.primary}",
      "$modes": { "dark": "{palette.red.light}" },
      "$description": "Errors, delete actions, and destructive states."
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Tight inline spacing (e.g. icon to label in a compact row)."
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Related elements within a group (e.g. text lines in a stack)."
    },
    "md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Default spacing between distinct elements."
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Separation between sections or groups of content."
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Major section breaks or generous padding around content areas."
    },
    "xxl": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Hero-level breathing room."
    }
  },
  "fontFamily": {
    "sansSerif": {
      "scale": 1.2,
      "regular": "NorthEastCN-Regular",
      "medium": "NorthEastCN-Medium",
      "semibold": "NorthEastCN-DemiBold",
      "bold": "NorthEastCN-Bold"
    },
    "serif": {
      "scale": 1.05,
      "regular": "FiveSerifText-Regular",
      "bold": "FiveSerifText-Bold"
    }
  },
  "typography": {
    "largeTitle": {
      "$type": "typography",
      "$value": {
        "textStyle": "largeTitle",
        "fontWeight": "bold",
        "fontFamily": "sansSerif",
        "textCase": "uppercase"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "textStyle": "title2",
        "fontWeight": "bold",
        "fontFamily": "sansSerif"
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "textStyle": "headline",
        "fontWeight": "semibold",
        "fontFamily": "sansSerif"
      }
    },
    "subheadline": {
      "$type": "typography",
      "$value": {
        "textStyle": "body",
        "fontWeight": "medium",
        "fontFamily": "sansSerif"
      },
      "$description": "UI chrome labels — row labels, button titles, picker labels."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "textStyle": "body",
        "fontWeight": "regular",
        "fontFamily": "serif"
      }
    },
    "callout": {
      "$type": "typography",
      "$value": {
        "textStyle": "callout",
        "fontWeight": "regular",
        "fontFamily": "serif"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "textStyle": "footnote",
        "fontWeight": "semibold",
        "fontFamily": "sansSerif"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "textStyle": "caption",
        "fontWeight": "semibold",
        "fontFamily": "sansSerif"
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "textStyle": "body",
        "fontWeight": "regular",
        "fontDesign": "monospaced"
      }
    }
  }
}

{
  "$modes": {
    "light": {},
    "dark": { "$fallback": "light" }
  },
  "palette": {
    "white": {
      "solid": { "$type": "color", "$value": "#FFFFFF" },
      "30": { "$type": "color", "$value": "#FFFFFF4D" },
      "50": { "$type": "color", "$value": "#FFFFFF80" },
      "70": { "$type": "color", "$value": "#FFFFFFB3" },
      "75": { "$type": "color", "$value": "#FFFFFFBF" }
    },
    "black": {
      "20": { "$type": "color", "$value": "#00000033" },
      "30": { "$type": "color", "$value": "#0000004D" },
      "50": { "$type": "color", "$value": "#00000080" }
    },
    "neutral": {
      "50": {
        "$type": "color",
        "$value": "#F6F6F2",
        "$modes": { "dark": "#0E0001" }
      },
      "100": {
        "$type": "color",
        "$value": "#F3F3F3",
        "$modes": { "dark": "#1B1B1B" }
      },
      "200": {
        "$type": "color",
        "$value": "#EAEAE9",
        "$modes": { "dark": "#232323" }
      },
      "300": {
        "$type": "color",
        "$value": "#DCDDDB",
        "$modes": { "dark": "#323331" }
      },
      "400": {
        "$type": "color",
        "$value": "#BABAB7",
        "$modes": { "dark": "#4C4C4A" }
      },
      "500": {
        "$type": "color",
        "$value": "#7E7F7B",
        "$modes": { "dark": "#7E7F7B" }
      },
      "600": {
        "$type": "color",
        "$value": "#797979",
        "$modes": { "dark": "#BABAB7" }
      },
      "700": {
        "$type": "color",
        "$value": "#4C4C4A",
        "$modes": { "dark": "#E8E8E8" }
      },
      "800": {
        "$type": "color",
        "$value": "#323331",
        "$modes": { "dark": "#EFEFEF" }
      },
      "900": {
        "$type": "color",
        "$value": "#1E1E1D",
        "$modes": { "dark": "#F6F6F2" }
      }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#757B3E" },
      "primarySubtle": {
        "$type": "color",
        "$value": "#A4AA6B",
        "$modes": { "dark": "#565B29" }
      },
      "secondary": { "$type": "color", "$value": "#FCAF53" },
      "secondaryHeadlines": { "$type": "color", "$value": "#FFCA8B" },
      "primaryDeep": { "$type": "color", "$value": "#42674A" },
      "accent": { "$type": "color", "$value": "#B39779" },
      "accentSubtle": {
        "$type": "color",
        "$value": "#DEC8B0",
        "$modes": { "dark": "#82674A" }
      },
      "textOnSpot": { "$type": "color", "$value": "{palette.white.solid}" }
    },
    "negative": { "$type": "color", "$value": "#FF0004" },
    "warning": { "$type": "color", "$value": "#DAA551" },
    "positive": { "$type": "color", "$value": "#1EAB31" }
  },
  "color": {
    "surface": {
      "standard": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.200}",
          "$description": "Default surface — cards, grouped rows."
        },
        "alternative": {
          "$type": "color",
          "$value": "{palette.neutral.100}",
          "$description": "Alternative surface — slightly elevated above base."
        },
        "elevated": {
          "$type": "color",
          "$value": "{palette.neutral.50}",
          "$description": "Elevated surface — sheets, modals, popovers."
        }
      },
      "impact": {
        "base": {
          "$type": "color",
          "$value": "{palette.brand.primary}",
          "$description": "High-emphasis branded surface."
        },
        "elevated": {
          "$type": "color",
          "$value": "{palette.brand.primaryDeep}",
          "$description": "Elevated branded surface — deeper primary tone."
        },
        "alternative": {
          "$type": "color",
          "$value": "{palette.brand.secondary}",
          "$description": "Alternative branded surface — secondary colour."
        },
        "subtle": {
          "$type": "color",
          "$value": "{palette.brand.accent}",
          "$description": "Subtle branded surface — accent tone."
        }
      }
    },
    "text": {
      "standard": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.800}",
          "$description": "Primary readable text."
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.black.50}",
          "$modes": { "dark": "{palette.white.50}" },
          "$description": "Secondary / supporting text."
        },
        "link": {
          "$type": "color",
          "$value": "{palette.brand.primary}",
          "$description": "Tappable links."
        },
        "disabled": {
          "$type": "color",
          "$value": "{palette.black.30}",
          "$modes": { "dark": "{palette.white.30}" },
          "$description": "Non-interactive disabled text."
        },
        "error": {
          "$type": "color",
          "$value": "{palette.negative}",
          "$description": "Validation errors and destructive labels."
        }
      },
      "impact": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.100}",
          "$modes": { "dark": "{palette.neutral.800}" },
          "$description": "Primary text on impact surfaces."
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.white.70}",
          "$description": "Secondary text on impact surfaces."
        },
        "link": {
          "$type": "color",
          "$value": "{palette.neutral.200}",
          "$description": "Links on impact surfaces."
        },
        "disabled": {
          "$type": "color",
          "$value": "{palette.white.50}",
          "$description": "Disabled text on impact surfaces."
        }
      },
      "button": {
        "onPrimary": {
          "$type": "color",
          "$value": "{palette.neutral.800}",
          "$description": "Text on primary buttons."
        },
        "onSecondary": {
          "$type": "color",
          "$value": "{palette.neutral.800}",
          "$description": "Text on secondary buttons."
        },
        "disabled": {
          "$type": "color",
          "$value": "{palette.neutral.400}",
          "$description": "Text on disabled buttons."
        }
      }
    },
    "button": {
      "standard": {
        "primary": {
          "$type": "color",
          "$value": "{palette.brand.secondary}",
          "$description": "Primary button fill."
        },
        "secondary": {
          "$type": "color",
          "$value": "{palette.white.30}",
          "$modes": { "dark": "{palette.black.30}" },
          "$description": "Secondary button fill."
        }
      },
      "spot": {
        "base": {
          "$type": "color",
          "$value": "{palette.brand.primary}",
          "$description": "Spot button fill."
        }
      },
      "impact": {
        "primary": {
          "$type": "color",
          "$value": "{palette.black.50}",
          "$description": "Primary button fill on impact surfaces."
        },
        "secondary": {
          "$type": "color",
          "$value": "{palette.white.50}",
          "$description": "Secondary button fill on impact surfaces."
        }
      },
      "navigation": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.50}",
          "$modes": { "dark": "{palette.neutral.100}" },
          "$description": "Navigation button fill."
        }
      }
    },
    "input": {
      "standard": {
        "active": {
          "$type": "color",
          "$value": "{palette.neutral.300}",
          "$modes": { "dark": "{palette.neutral.500}" },
          "$description": "Input field background when active / focused."
        },
        "inactive": {
          "$type": "color",
          "$value": "{palette.neutral.300}",
          "$description": "Input field background when inactive."
        }
      }
    },
    "icon": {
      "standard": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.900}",
          "$description": "Default icon colour."
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.black.50}",
          "$modes": { "dark": "{palette.white.50}" },
          "$description": "Secondary / supporting icon."
        },
        "disabled": {
          "$type": "color",
          "$value": "{palette.black.20}",
          "$modes": { "dark": "{palette.white.50}" },
          "$description": "Non-interactive icon."
        }
      },
      "impact": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.50}",
          "$description": "Icon on impact surfaces."
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.white.75}",
          "$description": "Secondary icon on impact surfaces."
        },
        "disabled": {
          "$type": "color",
          "$value": "{palette.white.50}",
          "$description": "Disabled icon on impact surfaces."
        }
      },
      "signal": {
        "negative": {
          "$type": "color",
          "$value": "{palette.negative}",
          "$description": "Error icon."
        },
        "notice": {
          "$type": "color",
          "$value": "{palette.warning}",
          "$description": "Warning icon."
        },
        "approve": {
          "$type": "color",
          "$value": "{palette.positive}",
          "$description": "Success icon."
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{palette.brand.accent}",
      "$description": "Primary interactive accent — buttons, links, highlights."
    },
    "border": {
      "standard": {
        "base": {
          "$type": "color",
          "$value": "{palette.neutral.400}",
          "$description": "Default border — dividers, input borders, separators."
        }
      },
      "signal": {
        "negative": {
          "$type": "color",
          "$value": "{palette.negative}",
          "$description": "Error / destructive border."
        },
        "notice": {
          "$type": "color",
          "$value": "{palette.warning}",
          "$description": "Warning / attention border."
        },
        "approve": {
          "$type": "color",
          "$value": "{palette.positive}",
          "$description": "Success / confirmation border."
        }
      }
    }
  },
  "spacing": {
    "n2": { "$type": "dimension", "$value": "2px" },
    "n4": { "$type": "dimension", "$value": "4px" },
    "n8": { "$type": "dimension", "$value": "8px" },
    "n12": { "$type": "dimension", "$value": "12px" },
    "n16": { "$type": "dimension", "$value": "16px" },
    "n20": { "$type": "dimension", "$value": "20px" },
    "n24": { "$type": "dimension", "$value": "24px" },
    "n28": { "$type": "dimension", "$value": "28px" },
    "n32": { "$type": "dimension", "$value": "32px" },
    "n40": { "$type": "dimension", "$value": "40px" },
    "n48": { "$type": "dimension", "$value": "48px" },
    "n56": { "$type": "dimension", "$value": "56px" },
    "n64": { "$type": "dimension", "$value": "64px" },
    "n72": { "$type": "dimension", "$value": "72px" },
    "n80": { "$type": "dimension", "$value": "80px" },
    "n88": { "$type": "dimension", "$value": "88px" },
    "n128": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Card and surface corners."
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Pill / fully rounded — avatar, input, buttons."
    }
  },
  "strokeWeight": {
    "standard": { "$type": "dimension", "$value": "3px" }
  },
  "grid": {
    "mobile": {
      "columns": { "$type": "number", "$value": 2 },
      "outer": { "$type": "dimension", "$value": "8px" },
      "inner": { "$type": "dimension", "$value": "32px" },
      "gutter": { "$type": "dimension", "$value": "16px" }
    },
    "tablet": {
      "columns": { "$type": "number", "$value": 4 },
      "outer": { "$type": "dimension", "$value": "16px" },
      "inner": { "$type": "dimension", "$value": "40px" },
      "gutter": { "$type": "dimension", "$value": "24px" }
    },
    "desktop": {
      "columns": { "$type": "number", "$value": 4 },
      "outer": { "$type": "dimension", "$value": "24px" },
      "inner": { "$type": "dimension", "$value": "56px" },
      "gutter": { "$type": "dimension", "$value": "24px" }
    }
  },
  "letterSpacing": {
    "standard": { "$type": "dimension", "$value": "0px" },
    "xxxs": { "$type": "dimension", "$value": "-2px" },
    "xxs": { "$type": "dimension", "$value": "-1px" },
    "xs": { "$type": "dimension", "$value": "-0.5px" },
    "s": { "$type": "dimension", "$value": "0.5px" },
    "m": { "$type": "dimension", "$value": "0.75px" },
    "l": { "$type": "dimension", "$value": "1px" }
  },
  "fontFamily": {
    "display": {
      "scale": 1.0,
      "extralight": "NorthEastCN-ExtraLight",
      "light": "NorthEastCN-Light",
      "regular": "NorthEastCN-Regular",
      "medium": "NorthEastCN-Medium",
      "demibold": "NorthEastCN-DemiBold",
      "bold": "NorthEastCN-Bold",
      "extrabold": "NorthEastCN-ExtraBold"
    },
    "ui": {
      "scale": 1.0,
      "extralight": "FiveSerifText-UltraLight",
      "light": "FiveSerifText-Light",
      "regular": "FiveSerifText-Regular",
      "demibold": "FiveSerifText-DemiBold",
      "bold": "FiveSerifText-Bold",
      "extrabold": "FiveSerifText-ExtraBold"
    }
  },
  "typography": {
    "titleXl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 42,
        "lineHeight": 55,
        "letterSpacing": "s"
      }
    },
    "titleL": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 36,
        "lineHeight": 34,
        "letterSpacing": "xs"
      }
    },
    "titleM": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 30,
        "lineHeight": 28,
        "letterSpacing": "standard"
      }
    },
    "titleS": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 26,
        "lineHeight": 26,
        "letterSpacing": "standard"
      }
    },
    "titleXS": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 20,
        "lineHeight": 25.3,
        "letterSpacing": "standard"
      }
    },
    "authorL": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "regular",
        "fontSize": 23,
        "lineHeight": 27.6,
        "letterSpacing": "standard"
      }
    },
    "authorS": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "regular",
        "fontSize": 18,
        "lineHeight": 21.6,
        "letterSpacing": "s"
      }
    },
    "standfirst": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 20,
        "lineHeight": 26,
        "letterSpacing": "m"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 17,
        "lineHeight": 23.8,
        "letterSpacing": "s"
      }
    },
    "chatMessage": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 22,
        "lineHeight": 28,
        "letterSpacing": 0.2
      }
    },
    "chatMessageUser": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 22,
        "lineHeight": 28,
        "letterSpacing": 0.2
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 16,
        "lineHeight": 16,
        "letterSpacing": "s",
        "textCase": "uppercase"
      }
    },
    "buttonSmall": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 14,
        "lineHeight": 16,
        "letterSpacing": "s",
        "textCase": "uppercase"
      }
    },
    "buttonLarge": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 18,
        "lineHeight": 16,
        "letterSpacing": "s"
      }
    },
    "navTab": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "demibold",
        "fontSize": 16,
        "lineHeight": 16,
        "letterSpacing": "m"
      }
    },
    "tag": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "demibold",
        "fontSize": 14,
        "lineHeight": 18.2,
        "letterSpacing": "s"
      }
    },
    "miniLabel": {
      "$type": "typography",
      "$value": {
        "fontFamily": "display",
        "fontWeight": "bold",
        "fontSize": 13,
        "lineHeight": 18,
        "letterSpacing": "s",
        "textCase": "uppercase"
      }
    },
    "note": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 14,
        "lineHeight": 16.8,
        "letterSpacing": "standard"
      }
    },
    "description": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 18,
        "lineHeight": 20.8,
        "letterSpacing": "standard"
      }
    },
    "descriptionSmall": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 14,
        "lineHeight": 17.5,
        "letterSpacing": "standard"
      }
    },
    "descriptionExpo": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui",
        "fontWeight": "regular",
        "fontSize": 20,
        "lineHeight": 23,
        "letterSpacing": "standard"
      }
    }
  }
}
